# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Secrets / env (mirror docs/SECURITY.md protected list)
.env
.env.*
*.pem
*.key
*.p12
id_rsa*
.ssh/
secrets/
.agent-toolkit-backup/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Local evaluation artifacts
.artifacts/
__pycache__/

# Versioned toolkit eval harness (the repository's local exclude historically ignores evals/)
!evals/
evals/*
!evals/__init__.py
!evals/__main__.py
!evals/runner.py
!evals/cases.json
!evals/fixtures/
!evals/fixtures/**
!evals/hidden/
!evals/hidden/**
evals/**/__pycache__/
evals/**/*.pyc

# Versioned legacy baseline used by the eval runner
!AGENTS_WORKFLOW_LEGACY/
AGENTS_WORKFLOW_LEGACY/*
!AGENTS_WORKFLOW_LEGACY/AGENTS_v1.md
